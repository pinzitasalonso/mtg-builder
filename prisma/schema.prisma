generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Privacy-respecting analytics: per-day counts of events only. No IPs, no user
// agents, no cookies, no per-user rows — just how many times each thing
// happened on a given (UTC) day.
model AnalyticsDaily {
  id    Int    @id @default(autoincrement())
  day   String // YYYY-MM-DD (UTC)
  type  String
  count Int    @default(0)

  @@unique([day, type])
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  // Email verification: null until the emailed link is clicked. The token is
  // stored as its SHA-256 (same discipline as Session ids) with a 24h expiry.
  emailVerifiedAt   DateTime?
  verifyTokenHash   String?   @unique
  verifyTokenExpiry DateTime?
  // Plan gating: "free" (3 decks, 4 AI asks/day) or "pro" — the future
  // paid tier — which lifts every cap.
  tier         String    @default("free")
  // Daily AI meter: calls made on aiDay (UTC); stale aiDay means zero used.
  aiDay        String?
  aiCount      Int       @default(0)
  decks        Deck[]
  sessions     Session[]
  collection   CollectionCard[]
  playCodes    PlayCode[]
}

// A card the user physically owns, for "do I have this?" checks across their
// decks and to ground the AI in their real collection. Stored as name + quantity
// only (no Scryfall resolution) so importing a large collection stays instant;
// ownership is matched by name. nameKey is the lowercased name for case-insensitive
// dedupe and lookups.
model CollectionCard {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  nameKey  String
  quantity Int    @default(1)
  // Scryfall metadata, resolved lazily server-side so the collection browser's
  // filters work instantly and completely instead of racing a client fetch.
  colorIdentity String?
  typeLine      String?
  manaCost      String?
  imageUri      String?
  // True once resolved against Scryfall (even if the name didn't resolve), so
  // the same names aren't re-queried on every load.
  enriched Boolean @default(false)

  @@unique([userId, nameKey])
}

// Server-side sessions; id is the SHA-256 of the cookie token, so a DB leak
// alone can't be replayed as a login.
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Deck {
  id        Int        @id @default(autoincrement())
  // Unguessable public identifier used in URLs (so decks can't be enumerated
  // by walking sequential ids). Nullable only so existing rows survive the
  // schema push; every deck is assigned one (at creation, or backfilled).
  publicId  String?    @unique
  name      String
  format    String     @default("commander")
  commander String?
  // When true, anyone with the deck's URL can VIEW it (read-only). Editing is
  // still restricted to the owner. Independent of ownerless "public" decks
  // (userId null), which stay fully editable by anyone by design.
  shared    Boolean    @default(false)
  // The deck's primer: the Markdown document you read to learn how to pilot
  // it — the plan, opening hands, lines, combos, what beats it. Written by
  // hand or drafted by the assistant in the iOS app.
  //
  // It replaced the old `notes` scratchpad — two boxes asking "how does this
  // deck play?" was one too many, and this is the one you'd hand to someone
  // who asks.
  primer    String?
  // Game-night record: incremented by play-code results (a friend's tracker
  // reporting a finished game) and by the owner's own tracker via /record.
  gamesPlayed Int      @default(0)
  gamesWon    Int      @default(0)
  createdAt DateTime   @default(now())
  // Nullable so pre-auth decks survive the migration; the first user to sign
  // up adopts them (they belong to whoever ran the instance before auth).
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     PoolCard[]
  playCodes PlayCode[]
  games     GameLog[]
}

// One played game against one deck. `Deck.gamesPlayed` / `gamesWon` is the
// free running summary; this is the log behind it, and KEEPING IT IS A PRO
// FEATURE.
//
// That gate lived only in the iOS client (SyncStore.recordGameResult wrapped
// the insert in `if isPro`), which meant any other client — the web, a curl —
// could keep a history without paying for one. It is enforced in the /record
// route now, and the client-side check is a courtesy rather than the rule.
//
// Opponents are NAMES rather than relations, matching iOS: most of them are
// friends' decks this server has never seen — a seat filled by play code, or
// a name typed at the table — so a relation could only record the minority of
// games played against another deck in this database. Stored as JSON because
// SQLite has no array type.
model GameLog {
  id        Int      @id @default(autoincrement())
  deckId    Int
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  won       Boolean
  // JSON array of opponent deck names, in seat order.
  opponents String   @default("[]")
  note      String?
  // Set when the player typed the game in rather than playing it through the
  // tracker. Worth distinguishing: a hand-entered record is someone's memory
  // and the tracker's is a measurement.
  isManual  Boolean  @default(false)
  playedAt  DateTime @default(now())

  @@index([deckId, playedAt])
}

// A short-lived "seat me at your table" code. The deck's owner mints one, a
// friend types it into THEIR life tracker, and the seat fills with this
// player and deck (name + commander art); the game's result is recorded back
// onto the deck. Display fields are snapshotted at mint so resolving needs no
// joins and a mid-night deck edit doesn't rewrite a live table.
model PlayCode {
  code              String   @id
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckId            Int
  deck              Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  playerName        String
  deckName          String
  commander         String?
  commanderImageUri String?
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  // Set the first time a result is reported for this code, so a game records
  // exactly once — a code can't be replayed to inflate the deck's record.
  reportedAt        DateTime?
}

model PoolCard {
  id            Int      @id @default(autoincrement())
  deckId        Int
  deck          Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  scryfallId    String
  name          String
  imageUri      String
  manaCost      String?
  typeLine      String?
  oracleText    String?
  quantity      Int      @default(1)
  // "pool" = candidate pile, "deck" = promoted to the actual decklist.
  board         String   @default("pool")
  // Deck role (land/ramp/draw/removal/wincon/utility) — null until tagged.
  role          String?
  // Scryfall color identity as WUBRG letters ("" = colorless); null = not yet enriched.
  colorIdentity String?
  // Scryfall legalities map, JSON-encoded; null = not yet enriched.
  legalities    String?
  addedAt       DateTime @default(now())

  @@unique([deckId, scryfallId])
}
