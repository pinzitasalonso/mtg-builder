generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  // Email verification: null until the emailed link is clicked. The token is
  // stored as its SHA-256 (same discipline as Session ids) with a 24h expiry.
  emailVerifiedAt   DateTime?
  verifyTokenHash   String?   @unique
  verifyTokenExpiry DateTime?
  decks        Deck[]
  sessions     Session[]
  collection   CollectionCard[]
}

// A card the user physically owns, for "do I have this?" checks across their
// decks and to ground the AI in their real collection. Stored as name + quantity
// only (no Scryfall resolution) so importing a large collection stays instant;
// ownership is matched by name. nameKey is the lowercased name for case-insensitive
// dedupe and lookups.
model CollectionCard {
  id       Int    @id @default(autoincrement())
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  nameKey  String
  quantity Int    @default(1)
  // Scryfall metadata, resolved lazily server-side so the collection browser's
  // filters work instantly and completely instead of racing a client fetch.
  colorIdentity String?
  typeLine      String?
  manaCost      String?
  imageUri      String?
  // True once resolved against Scryfall (even if the name didn't resolve), so
  // the same names aren't re-queried on every load.
  enriched Boolean @default(false)

  @@unique([userId, nameKey])
}

// Server-side sessions; id is the SHA-256 of the cookie token, so a DB leak
// alone can't be replayed as a login.
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Deck {
  id        Int        @id @default(autoincrement())
  // Unguessable public identifier used in URLs (so decks can't be enumerated
  // by walking sequential ids). Nullable only so existing rows survive the
  // schema push; every deck is assigned one (at creation, or backfilled).
  publicId  String?    @unique
  name      String
  format    String     @default("commander")
  commander String?
  // Free-form play notes: mulligans, lines, win routes.
  notes     String?
  createdAt DateTime   @default(now())
  // Nullable so pre-auth decks survive the migration; the first user to sign
  // up adopts them (they belong to whoever ran the instance before auth).
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards     PoolCard[]
}

model PoolCard {
  id            Int      @id @default(autoincrement())
  deckId        Int
  deck          Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  scryfallId    String
  name          String
  imageUri      String
  manaCost      String?
  typeLine      String?
  oracleText    String?
  quantity      Int      @default(1)
  // "pool" = candidate pile, "deck" = promoted to the actual decklist.
  board         String   @default("pool")
  // Deck role (land/ramp/draw/removal/wincon/utility) — null until tagged.
  role          String?
  // Scryfall color identity as WUBRG letters ("" = colorless); null = not yet enriched.
  colorIdentity String?
  // Scryfall legalities map, JSON-encoded; null = not yet enriched.
  legalities    String?
  addedAt       DateTime @default(now())

  @@unique([deckId, scryfallId])
}
