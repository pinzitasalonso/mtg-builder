# ---- required to boot -------------------------------------------------------

# Local dev: a file in the project dir works fine, e.g. file:./dev.db
# Railway: set this in Variables to file:/data/db.sqlite and mount a Volume
# at /data so the SQLite database survives redeploys (otherwise the container
# filesystem is wiped on every deploy and all decks are lost).
DATABASE_URL="file:/data/db.sqlite"

# ---- strongly recommended in production --------------------------------------

# The public origin, used for links in emails and for the OAuth redirect_uri.
# Without it the origin is reconstructed from proxy headers, which is fine
# until it isn't: Google compares redirect_uri byte for byte, so any drift
# (a missing www, a trailing slash) breaks every Google sign-in.
APP_URL="https://www.spellpool.com"

# ---- features that degrade without their keys --------------------------------

# Anthropic — the AI chat, card search and role tagging.
ANTHROPIC_API_KEY=

# Resend. Without a key, emails are logged to the server console instead of
# sent, which keeps signup and password reset usable in local dev.
RESEND_API_KEY=
# Resend's shared sender only delivers to the Resend account owner. Verify a
# domain and set this to email anyone else.
EMAIL_FROM="Spellpool <hello@spellpool.com>"

# Google sign-in. Create a "Web application" OAuth client — NOT the iOS type,
# which has no secret and cannot do the server-side exchange both clients
# share. Authorized redirect URI:
#   https://www.spellpool.com/api/auth/oauth/google/callback
# Remember to PUBLISH the consent screen; while it is in "Testing" only listed
# test users can sign in. Unset, the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple, native only. The audience of an identity token from the
# iOS app is the app's bundle id — there is no Services ID or .p8 key here.
# Only override if the bundle id changes.
APPLE_BUNDLE_ID="com.ios.spellpool"

# The custom scheme the iOS app listens on to finish an OAuth sign-in.
IOS_CALLBACK_SCHEME="spellpool"

# RevenueCat. The webhook token is a shared secret checked on the Authorization
# header; the API key is the PUBLIC appl_ key — v1 subscriber reads work with
# it, and sk_ secret keys must never be committed or handled here.
REVENUECAT_WEBHOOK_TOKEN=
REVENUECAT_API_KEY=

# CardTrader — price lookups.
CARDTRADER_API_TOKEN=

# The one address allowed to open /admin and the analytics summary.
ANALYTICS_ADMIN_EMAIL=
